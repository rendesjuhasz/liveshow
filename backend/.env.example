# Másold backend/.env névre. Ne commitold a kitöltött fájlt.
# Titok: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/streaming?schema=public
PORT=3200
APP_URL=https://streamtest.hu
FRONTEND_URL=https://streamtest.hu
BACKEND_URL=https://streamtest.hu
BACKEND_PUBLIC_URL=https://streamtest.hu

JWT_SECRET=
STREAM_SECRET=

# Admin fiókot NE regisztrációval hozz létre. CLI: npm run create-admin -- email jelszo "Név"
# BOOTSTRAP_ADMIN_EMAIL csak a CLI alapértelmezett emailje lehet, nem ad automatikus jogosultságot.
BOOTSTRAP_ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tesztfizetés kártya nélkül (confirm-dev). Gépen és teszt-VPS-en: true. Éles Stripe/Barion mellett: false.
ALLOW_DEV_PAY=true

ADMIN_EMAIL=
CONTACT_EMAIL=

# SMTP hiányában: backend/mail-outbox/
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Élesben kötelező. Devben memória-limiter, ha üres.
REDIS_URL=

BARION_ENABLED=false
BARION_POS_KEY=
BARION_PAYEE=
BARION_ENV=test
BARION_WEBHOOK_SECRET=
BARION_IP_ALLOWLIST=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Live video SFU. Production: livekit + filled keys. Without keys the API still falls back to mesh.
# Helyi/mesh: mesh. Éles SFU: livekit + kitöltött kulcsok.
LIVE_VIDEO_BACKEND=mesh
LIVEKIT_SHOW_IDS=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PUBLIC_URL=wss://live.YOUR_DOMAIN
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_TOKEN_TTL_SEC=3600

# Social login (OAuth 2.0 / OIDC). Redirect URI: {APP_URL}/api/auth/oauth/{google|microsoft|apple}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
